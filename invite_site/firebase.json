{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "rewrites": [{ "source": "/i/**", "destination": "/invite.html" }],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self'" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      }
    ]
  }
}
