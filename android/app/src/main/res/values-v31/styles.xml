<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash before the app draws. Make it
         the same deep teal as the Flutter splash, with no icon, so the two
         read as one continuous launch instead of "icon screen, then splash". -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF173D35</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Brand colour behind the first Flutter frame too: no white flash. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
